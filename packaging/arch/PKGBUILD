# Maintainer: Wagner Brahm <https://github.com/brahm>
# Builds Core Rules for Arch Linux and the distributions built on it
# (CachyOS, Omarchy, Manjaro, EndeavourOS). packaging/arch/build.sh sets
# pkgver and _tag from the release and builds from the checkout; on its
# own, makepkg fetches the release's source from GitHub.
pkgname=corerules
# A pre-release (1.0.0-rc1) drops the hyphen, which pacman does not allow
# in a version: 1.0.0rc1 sorts before 1.0.0.
pkgver=1.2.0
_tag=v1.2.0
pkgrel=1
pkgdesc='Browse and edit AD&D Core Rules 2.0 characters and rules'
arch=('x86_64')
url='https://github.com/brahm/corerules'
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2' 'hicolor-icon-theme' 'gcc-libs' 'glibc')
makedepends=('cargo')
checkdepends=('desktop-file-utils' 'appstream-glib')
options=('!debug' '!lto')
source=("$pkgname-${_tag#v}.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
# GitHub's tarball of a tag can change when GitHub changes its archiver.
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-${_tag#v}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-${_tag#v}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-${_tag#v}"
    desktop-file-validate data/io.github.brahm.CoreRules.desktop
    appstream-util validate-relax --nonet data/io.github.brahm.CoreRules.metainfo.xml
}

package() {
    cd "$pkgname-${_tag#v}"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    packaging/install.sh "$pkgdir" /usr target/release
}
