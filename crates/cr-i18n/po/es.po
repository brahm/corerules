msgstr "Debe indicar un nombre para la tabla."

#: crates/cr-store/src/userdb/tables.rs:27
msgid "This will delete the selected table.  You will lose any customizations."
msgstr "Se eliminará la tabla seleccionada. Perderá cualquier personalización."

#: crates/cr-store/src/userdb/tables.rs:28
msgid "This will revert the selected table to match the Dungeon Master's Guide. You will lose any customizations."
msgstr "La tabla seleccionada volverá a coincidir con la Dungeon Master's Guide. Perderá cualquier personalización."

#: crates/cr-store/src/userdb/tables.rs:136
msgid "Standard tables cannot be deleted; restore them instead."
msgstr "Las tablas estándar no se pueden eliminar; restáurelas."

#: crates/cr-store/src/userdb/tables.rs:149
msgid "{name} is not in the Dungeon Master's Guide tables."
msgstr "{name} no está en las tablas de la Dungeon Master's Guide."

