msgstr "A causa della pessima Costituzione del tuo personaggio, non è stata fatta nessuna modifica."

#: crates/cr-store/src/skills/wild.rs:246
msgid "You just lost {loss} from your Wisdom score."
msgstr "Hai appena perso {loss} punti di Saggezza."

#: crates/cr-store/src/skills/wild.rs:247
msgid "You just lost {loss} from your Intelligence score."
msgstr "Hai appena perso {loss} punti di Intelligenza."

#: crates/cr-store/src/skills/wild.rs:248
msgid "You just lost {loss} from your Constitution score."
msgstr "Hai appena perso {loss} punti di Costituzione."

#: crates/cr-store/src/skills/wild.rs:268
msgid ""
"Congratulations, you made your Saving Throw.\n"
"(You needed to roll {target} or higher and you had a roll of {roll})."
msgstr ""
"Congratulazioni, hai superato il tiro salvezza.\n"
"(Dovevi ottenere {target} o più e hai ottenuto {roll})."

#: crates/cr-store/src/skills/wild.rs:275
msgid ""
"You failed to save.\n"
"(You needed to roll {target} or higher and you had a modified roll of {roll}).\n"
"Prepare to face the consequences."
msgstr ""
"Non hai superato il tiro salvezza.\n"
"(Dovevi ottenere {target} o più e, con il modificatore, hai ottenuto {roll}).\n"
"Preparati alle conseguenze."

#: crates/cr-store/src/skills/wild.rs:282
msgid ""
"You failed to save.\n"
"(You needed to roll {target} or higher and you had a roll of {roll}).\n"
"Prepare to face the consequences."
msgstr ""
"Non hai superato il tiro salvezza.\n"
"(Dovevi ottenere {target} o più e hai ottenuto {roll}).\n"
"Preparati alle conseguenze."

#: crates/cr-store/src/skills/wild.rs:304
